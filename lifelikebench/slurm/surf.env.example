# Copy to slurm/surf.env and fill in. Reuse what Character_Benchmark already has on
# /projects/prjs1995 (venv with vLLM, HF cache / weights) — nothing needs to be re-downloaded.
export PROJECT_ROOT=/projects/prjs1995
export REPO_DIR=$PROJECT_ROOT/lifelike-bench            # where this repo is cloned on Snellius
export RESULTS_DIR=$PROJECT_ROOT/lifelike-bench-results

# --- environment: reuse a conda env that has vLLM (as in Character_Benchmark / dongpo) ---
activate_env () {
  module purge
  module load 2025
  module load Anaconda3/2025.06-1
  source activate dongpo-vllm          # the conda env that has vllm installed
}
# Keep the HF cache on project storage, not in $HOME (models are ~160 GB in total).
export HF_HOME=$PROJECT_ROOT/hf_cache

# Leave empty to load models by HF id from the cache in $HF_HOME.
# If your weights live in plain folders instead (e.g. $PROJECT_ROOT/models/Qwen/Qwen3-8B),
# set MODEL_DIR=$PROJECT_ROOT/models/   (trailing slash) — configs prepend it to each path.
export MODEL_DIR=

# Jobs never hit the network: everything must be in $HF_HOME first (slurm/download_models.sh).
export HF_HUB_OFFLINE=1
# export HF_TOKEN=...   # only needed by download_models.sh for gated repos (Llama, Gemma)

# FlashInfer's sampler compiles CUDA code at startup and needs nvcc, which the conda env does
# not have ("Could not find nvcc"). Use vLLM's PyTorch sampler instead (same results).
export VLLM_USE_FLASHINFER_SAMPLER=0
